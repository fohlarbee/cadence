// Cadence — Automatic Timetable Generator. Data model.
// SQLite for local dev; scripts/db-provider.mjs flips `provider` to "postgresql" for deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Admin accounts (Cadence is admin-only; role kept for future growth).
model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model Department {
  id   String @id @default(cuid())
  name String
  code String @unique

  lecturers Lecturer[]
  cohorts   Cohort[]
  courses   Course[]
}

model Lecturer {
  id           String  @id @default(cuid())
  name         String
  title        String? // e.g. "Dr.", "Prof."
  departmentId String
  // JSON array of "day-period" slot strings the lecturer is NOT available, e.g. ["0-0","0-1"].
  unavailable  String  @default("[]")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courses    Course[]
}

// kind: HALL | LAB | SEMINAR (validated in app code).
model Room {
  id       String @id @default(cuid())
  name     String @unique
  capacity Int
  kind     String @default("HALL")

  assignments Assignment[]
}

// A student group that moves together, e.g. "CSC 200L". Two of its courses may never clash.
model Cohort {
  id           String @id @default(cuid())
  name         String
  level        Int // 100, 200, 300, 400
  size         Int
  departmentId String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courses    Course[]
}

model Course {
  id             String  @id @default(cuid())
  code           String  @unique
  title          String
  creditUnits    Int     @default(3)
  sessionsPerWeek Int    @default(2) // number of separate meetings per week
  sessionLength  Int     @default(1) // consecutive periods per meeting
  requiresKind   String? // null = any room; else HALL | LAB | SEMINAR
  lecturerId     String
  cohortId       String
  departmentId   String

  lecturer   Lecturer   @relation(fields: [lecturerId], references: [id])
  cohort     Cohort     @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  assignments Assignment[]
}

// A generated timetable version.
model Timetable {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("draft") // draft | published
  publicSlug  String?  @unique
  score       Int      @default(0) // total soft-penalty (lower is better)
  hardOk      Boolean  @default(true)
  unplaced    String   @default("[]") // JSON: [{ courseCode, title, reason }]
  params      String   @default("{}") // JSON snapshot of grid config + weights + seed
  generatedAt DateTime @default(now())

  assignments Assignment[]
}

// A single placed lecture meeting.
model Assignment {
  id          String @id @default(cuid())
  timetableId String
  courseId    String
  roomId      String
  day         Int // 0-based day index
  period      Int // 0-based start period index
  length      Int @default(1)

  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  room      Room      @relation(fields: [roomId], references: [id])
}

// Singleton grid configuration (row id is always "singleton").
model Settings {
  id            String @id @default("singleton")
  daysCount     Int    @default(5) // Mon..Fri
  periodsPerDay Int    @default(10) // e.g. 08:00..18:00 hourly
  periodMinutes Int    @default(60)
  dayStart      String @default("08:00")
  lunchPeriod   Int? // period index reserved for lunch (null = none)
}
